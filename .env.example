# Server-side Supabase credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Public values exposed to the Vite applications
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_API_URL=http://localhost:3000

# Local API server port
API_PORT=3000
DASHBOARD_ORIGIN=http://localhost:5174
PORTAL_ORIGIN=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Explicit opt-in required by local Auth user and MFA provisioning scripts.
ALLOW_DEV_AUTH_PROVISIONING=false